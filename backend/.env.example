# Codemaster-AI environment template
# Copy this file to backend/.env and customize locally.
# NEVER commit backend/.env.

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=300.0
OLLAMA_ENABLED=true

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Generation Defaults
GENERATION_TEMPERATURE=0.1
GENERATION_TOP_P=0.9
GENERATION_TOP_K=40
GENERATION_TIMEOUT=300.0

# Request Validation
MAX_PROMPT_LENGTH=20000
MAX_CODE_LENGTH=50000

# API Security
# Required for non-loopback clients; send as x-api-key or Bearer token.
API_KEY=

# MCP Streamable HTTP security. Add the exact request Host/Origin values used
# by remote MCP clients; local loopback hosts are allowed by default.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# LLM Provider Configuration
LLM_PROVIDER=ollama

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local vector/index storage
INDEX_DIR=data/index
